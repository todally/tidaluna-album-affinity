{
  "name": "tidaluna-album-affinity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discover albums based on the percentage of their tracks in your TIDAL favorites",
  "repository": {
    "type": "git",
    "url": "https://github.com/todally/tidaluna-album-affinity.git"
  },
  "scripts": {
    "build": "rimraf ./dist && tsx esbuild.config.ts",
    "watch": "concurrently \"pnpm:build --watch\" pnpm:serve",
    "serve": "http-server ./dist -p 3000 -s --cors -c-1",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "luna": "github:Inrixia/TidaLuna",
    "oby": "^15.1.2",
    "rimraf": "^6.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
